rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function manages(shelterId) {
      let uid = request.auth.uid;
      let membership = firestore.get(/databases/(default)/documents/membresias/$(uid + '__' + shelterId)).data;
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/usuarios/$(uid)).data.activo == true &&
        membership.usuarioUid == uid && membership.refugioId == shelterId && membership.activo == true &&
        firestore.get(/databases/(default)/documents/refugios/$(shelterId)).data.activo == true;
    }
    function references(dog, path) {
      let photos = dog.fotos;
      return (photos.size() > 0 && photos[0].ruta == path) || (photos.size() > 1 && photos[1].ruta == path) ||
        (photos.size() > 2 && photos[2].ruta == path) || (photos.size() > 3 && photos[3].ruta == path) ||
        (photos.size() > 4 && photos[4].ruta == path) || (photos.size() > 5 && photos[5].ruta == path);
    }
    function published(dogId, shelterId, path) {
      let dog = firestore.get(/databases/(default)/documents/perritos/$(dogId)).data;
      return dog.refugioId == shelterId && dog.publicado == true && dog.estado in ['Disponible','En proceso'] && references(dog,path);
    }
    function unused(dogId,shelterId,path) {
      return !firestore.exists(/databases/(default)/documents/perritos/$(dogId)) ||
        (firestore.get(/databases/(default)/documents/perritos/$(dogId)).data.refugioId == shelterId &&
         !references(firestore.get(/databases/(default)/documents/perritos/$(dogId)).data,path));
    }
    match /perritos/{shelterId}/{uid}/{dogId}/{fileName} {
      allow get: if published(dogId,shelterId,'perritos/' + shelterId + '/' + uid + '/' + dogId + '/' + fileName) || manages(shelterId);
      allow create, update: if request.auth != null && request.auth.uid == uid && manages(shelterId) &&
        dogId.matches('[A-Za-z0-9-]{1,100}') && fileName.matches('[A-Za-z0-9-]{1,100}\\.jpg') &&
        request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg' &&
        unused(dogId,shelterId,'perritos/' + shelterId + '/' + uid + '/' + dogId + '/' + fileName);
      allow delete: if request.auth != null && request.auth.uid == uid && manages(shelterId) &&
        unused(dogId,shelterId,'perritos/' + shelterId + '/' + uid + '/' + dogId + '/' + fileName);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
