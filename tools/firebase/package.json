{
  "name": "huellitas-firebase-tools",
  "private": true,
  "scripts": {
    "auth:start": "firebase emulators:start --config ../../firebase.json --only auth --project demo-huellitas-chalco",
    "start": "firebase emulators:start --config ../../firebase.json --only auth,firestore,storage --project demo-huellitas-chalco",
    "test:rules": "firebase emulators:exec --config ../../firebase.json --only firestore,storage --project demo-huellitas-chalco \"node --test --test-concurrency=1 test/*.test.mjs\"",
    "seed:local": "node seed-local.mjs",
    "seed:catalog": "node seed-catalog.mjs"
  },
  "devDependencies": {
    "firebase-tools": "15.37.0",
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase": "12.6.0"
  }
}
