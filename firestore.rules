rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function activeUser() {
      return signedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo == true;
    }
    function manages(refugioId) {
      let membership = get(/databases/$(database)/documents/membresias/$(request.auth.uid + '__' + refugioId));
      return activeUser() && refugioId is string &&
        membership.data.usuarioUid == request.auth.uid && membership.data.refugioId == refugioId &&
        membership.data.activo == true && get(/databases/$(database)/documents/refugios/$(refugioId)).data.activo == true;
    }
    function ownsRecord() { return activeUser() && resource.data.usuarioUid == request.auth.uid; }

    match /usuarios/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /membresias/{id} {
      allow read: if signedIn() && resource.data.usuarioUid == request.auth.uid;
      // Solo un administrador, fuera de la app, concede o revoca membresías.
      allow write: if false;
    }
    match /refugios/{id} {
      allow read: if resource.data.activo == true;
      allow write: if false;
    }
    function validPhoto(photo, index, dogId, shelterId) {
      return photo is map && photo.keys().hasOnly(['archivoId', 'ruta', 'orden']) &&
        photo.archivoId is string && photo.archivoId.matches('[A-Za-z0-9-]{1,100}') &&
        photo.orden == index && photo.ruta == 'perritos/' + shelterId + '/' + request.auth.uid + '/' + dogId + '/' + photo.archivoId + '.jpg';
    }
    function validPhotos(photos, dogId, shelterId) {
      let n = photos.size();
      return photos is list && n >= 1 && n <= 6 &&
        validPhoto(photos[0], 0, dogId, shelterId) &&
        (n < 2 || validPhoto(photos[1], 1, dogId, shelterId)) &&
        (n < 3 || validPhoto(photos[2], 2, dogId, shelterId)) &&
        (n < 4 || validPhoto(photos[3], 3, dogId, shelterId)) &&
        (n < 5 || validPhoto(photos[4], 4, dogId, shelterId)) &&
        (n < 6 || validPhoto(photos[5], 5, dogId, shelterId)) &&
        [photos[0].archivoId, n > 1 ? photos[1].archivoId : '_unused1', n > 2 ? photos[2].archivoId : '_unused2',
          n > 3 ? photos[3].archivoId : '_unused3', n > 4 ? photos[4].archivoId : '_unused4', n > 5 ? photos[5].archivoId : '_unused5'].toSet().size() == 6;
    }
    function validNewDog(d, id) {
      return id.matches('[A-Za-z0-9-]{1,100}') &&
        d.keys().hasAll(['refugioId','nombre','edadMeses','tamano','sexo','descripcion','vacunacion','desparasitacion','esterilizacion','estado','publicado','fotos','esDemostracion','creadoEn','actualizadoEn']) &&
        d.keys().hasOnly(['refugioId','nombre','edadMeses','tamano','sexo','descripcion','vacunacion','desparasitacion','esterilizacion','estado','publicado','fotos','esDemostracion','creadoEn','actualizadoEn']) &&
        manages(d.refugioId) && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 60 && d.nombre.matches('\\S([\\s\\S]*\\S)?') &&
        d.edadMeses is int && d.edadMeses >= 0 && d.edadMeses <= 360 &&
        d.tamano in ['Chico','Mediano','Grande'] && d.sexo in ['Hembra','Macho'] &&
        d.descripcion is string && d.descripcion.size() >= 40 && d.descripcion.size() <= 2000 && d.descripcion.matches('\\S([\\s\\S]*\\S)?') &&
        d.vacunacion == 'Sin información' && d.desparasitacion == 'Sin información' && d.esterilizacion == 'Sin información' &&
        d.estado == 'Disponible' && d.publicado == true && d.esDemostracion is bool &&
        d.creadoEn == request.time && d.actualizadoEn == request.time && validPhotos(d.fotos,id,d.refugioId) &&
        getAfter(/databases/$(database)/documents/perritos_control/$(id)).data.refugioId == d.refugioId;
    }
    match /perritos/{id} {
      allow read: if (resource.data.publicado == true && resource.data.estado in ['Disponible', 'En proceso']) || manages(resource.data.refugioId);
      // Permite comprobar un ID nuevo en una transacción, sin revelar documentos privados existentes.
      allow get: if resource == null && activeUser();
      allow create: if validNewDog(request.resource.data, id);
      // La edición y los cambios de estado se implementan en sus historias.
      allow update, delete: if false;
    }
    match /solicitudes/{id} { allow read: if ownsRecord() || manages(resource.data.refugioId); }
    match /historial_solicitudes/{id} { allow read: if ownsRecord() || manages(resource.data.refugioId); }
    match /adopciones/{id} { allow read: if ownsRecord() || manages(resource.data.refugioId); }
    match /revisiones/{id} { allow read: if manages(resource.data.refugioId); }
    match /seguimientos/{id} { allow read: if manages(resource.data.refugioId); }
    match /perritos_control/{id} {
      allow read: if manages(resource.data.refugioId);
      allow create: if manages(request.resource.data.refugioId) &&
        request.resource.data.keys().hasAll(['refugioId','solicitudAprobadaId','adopcionId']) &&
        request.resource.data.keys().hasOnly(['refugioId','solicitudAprobadaId','adopcionId']) &&
        request.resource.data.solicitudAprobadaId == null && request.resource.data.adopcionId == null &&
        !exists(/databases/$(database)/documents/perritos/$(id)) &&
        getAfter(/databases/$(database)/documents/perritos/$(id)).data.refugioId == request.resource.data.refugioId;
      allow update, delete: if false;
    }
    match /solicitudes_claves/{id} { allow read: if ownsRecord(); }
    // Las escrituras de negocio se habilitan al implementar y validar su historia.
    match /{document=**} { allow read, write: if false; }
  }
}
