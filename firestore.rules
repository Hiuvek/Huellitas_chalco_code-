rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function activeUser() {
      return signedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo == true;
    }
    function manages(refugioId) {
      let membership = get(/databases/$(database)/documents/membresias/$(request.auth.uid + '__' + refugioId));
      return activeUser() && refugioId is string &&
        membership.data.usuarioUid == request.auth.uid && membership.data.refugioId == refugioId &&
        membership.data.activo == true && get(/databases/$(database)/documents/refugios/$(refugioId)).data.activo == true;
    }
    // Authentication basta para un adoptante nuevo; un perfil desactivado sigue bloqueado.
    // Las membresías administrativas mantienen el requisito estricto de perfil activo.
    function adopterEnabled() {
      return signedIn() && (!exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo == true);
    }
    function ownsRecord() { return adopterEnabled() && resource.data.usuarioUid == request.auth.uid; }
    function applicationKey(uid,dogId) { return hashing.sha256(uid + '\u0000' + dogId).toHexString().lower(); }

    match /usuarios/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /membresias/{id} {
      allow read: if signedIn() && resource.data.usuarioUid == request.auth.uid;
      // Solo un administrador, fuera de la app, concede o revoca membresías.
      allow write: if false;
    }
    match /refugios/{id} {
      allow read: if resource.data.activo == true;
      allow update: if validShelterEdit(request.resource.data,id);
      allow create, delete: if false;
    }
    function validPublicText(value,maxSize) {
      return value is string && value.size() >= 1 && value.size() <= maxSize && value.matches('\\S([\\s\\S]*\\S)?');
    }
    function validPolicyList(value) {
      return value is list && value.size() >= 1 && value.size() <= 10 &&
        validPublicText(value[0],300) &&
        (value.size() < 2 || validPublicText(value[1],300)) &&
        (value.size() < 3 || validPublicText(value[2],300)) &&
        (value.size() < 4 || validPublicText(value[3],300)) &&
        (value.size() < 5 || validPublicText(value[4],300)) &&
        (value.size() < 6 || validPublicText(value[5],300)) &&
        (value.size() < 7 || validPublicText(value[6],300)) &&
        (value.size() < 8 || validPublicText(value[7],300)) &&
        (value.size() < 9 || validPublicText(value[8],300)) &&
        (value.size() < 10 || validPublicText(value[9],300));
    }
    function validShelterLocation(value) {
      return value == null || (value is map && value.keys().hasAll(['latitud','longitud']) && value.keys().hasOnly(['latitud','longitud']) &&
        value.latitud is number && value.longitud is number && value.latitud >= -90 && value.latitud <= 90 && value.longitud >= -180 && value.longitud <= 180);
    }
    function validShelterEdit(d,id) {
      return manages(id) && resource.data.municipio == 'Chalco' && resource.data.entidad == 'Estado de México' &&
        d.diff(resource.data).affectedKeys().hasOnly(['nombre','zonaPublica','horarioPublico','requisitos','pasos','ubicacionAproximada','actualizadoEn','actualizadoPorUid']) &&
        validPublicText(d.nombre,100) && validPublicText(d.zonaPublica,250) && validPublicText(d.horarioPublico,250) &&
        validPolicyList(d.requisitos) && validPolicyList(d.pasos) && validShelterLocation(d.get('ubicacionAproximada',null)) &&
        d.actualizadoEn == request.time && d.actualizadoPorUid == request.auth.uid;
    }
    function samePhoto(a, b) { return a.archivoId == b.archivoId && a.ruta == b.ruta; }
    function retainedPhoto(photo) {
      let old = resource.data.fotos;
      return samePhoto(photo,old[0]) || (old.size() > 1 && samePhoto(photo,old[1])) ||
        (old.size() > 2 && samePhoto(photo,old[2])) || (old.size() > 3 && samePhoto(photo,old[3])) ||
        (old.size() > 4 && samePhoto(photo,old[4])) || (old.size() > 5 && samePhoto(photo,old[5]));
    }
    function validPhoto(photo, index, dogId, shelterId) {
      return photo is map && photo.keys().hasOnly(['archivoId', 'ruta', 'orden']) &&
        photo.archivoId is string && photo.archivoId.matches('[A-Za-z0-9-]{1,100}') &&
        photo.orden == index && (photo.ruta == 'perritos/' + shelterId + '/' + request.auth.uid + '/' + dogId + '/' + photo.archivoId + '.jpg' ||
          (resource != null && retainedPhoto(photo)));
    }
    function validPhotos(photos, dogId, shelterId) {
      return photos is list && photos.size() == 1 && validPhoto(photos[0],0,dogId,shelterId);
    }
    function validHealth(d) {
      return d.vacunacion in ['Sí', 'No', 'Sin información'] &&
        d.desparasitacion in ['Sí', 'No', 'Sin información'] &&
        d.esterilizacion in ['Sí', 'No', 'Sin información'];
    }
    function validNewDog(d, id) {
      return id.matches('[A-Za-z0-9-]{1,100}') &&
        d.keys().hasAll(['refugioId','nombre','edadMeses','tamano','sexo','descripcion','vacunacion','desparasitacion','esterilizacion','estado','publicado','fotos','esDemostracion','creadoEn','actualizadoEn']) &&
        d.keys().hasOnly(['refugioId','nombre','edadMeses','tamano','sexo','descripcion','vacunacion','desparasitacion','esterilizacion','estado','publicado','fotos','esDemostracion','creadoEn','actualizadoEn']) &&
        manages(d.refugioId) && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 60 && d.nombre.matches('\\S([\\s\\S]*\\S)?') &&
        d.edadMeses is int && d.edadMeses >= 0 && d.edadMeses <= 360 &&
        d.tamano in ['Chico','Mediano','Grande'] && d.sexo in ['Hembra','Macho'] &&
        d.descripcion is string && d.descripcion.size() >= 40 && d.descripcion.size() <= 2000 && d.descripcion.matches('\\S([\\s\\S]*\\S)?') &&
        validHealth(d) &&
        d.estado == 'Disponible' && d.publicado == true && d.esDemostracion is bool &&
        d.creadoEn == request.time && d.actualizadoEn == request.time && validPhotos(d.fotos,id,d.refugioId) &&
        getAfter(/databases/$(database)/documents/perritos_control/$(id)).data.refugioId == d.refugioId;
    }
    function validEditedDog(d,id) {
      return d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 60 && d.nombre.matches('\\S([\\s\\S]*\\S)?') &&
        d.edadMeses is int && d.edadMeses >= 0 && d.edadMeses <= 360 &&
        d.tamano in ['Chico','Mediano','Grande'] && d.sexo in ['Hembra','Macho'] &&
        d.descripcion is string && d.descripcion.size() >= 40 && d.descripcion.size() <= 2000 && d.descripcion.matches('\\S([\\s\\S]*\\S)?') &&
        validHealth(d) && validPhotos(d.fotos,id,resource.data.refugioId);
    }
    match /perritos/{id} {
      allow read: if (resource.data.publicado == true && resource.data.estado in ['Disponible', 'En proceso']) || manages(resource.data.refugioId);
      allow get: if resource.data.publicado == true && resource.data.estado == 'Adoptado' && adopterEnabled() &&
        get(/databases/$(database)/documents/adopciones/$(id)).data.usuarioUid == request.auth.uid;
      // Permite comprobar un ID nuevo en una transacción, sin revelar documentos privados existentes.
      allow get: if resource == null && activeUser();
      allow create: if validNewDog(request.resource.data, id);
      // Salud y datos generales se guardan por separado; propietario y ciclo de adopción son inmutables aquí.
      allow update: if request.resource.data.estado == resource.data.estado && resource.data.get('eliminado', false) == false && manages(resource.data.refugioId) && request.resource.data.actualizadoEn == request.time && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vacunacion','desparasitacion','esterilizacion','actualizadoEn']) &&
          validHealth(request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre','edadMeses','tamano','sexo','descripcion','fotos','actualizadoEn']) &&
          validEditedDog(request.resource.data,id))
      );
      allow update: if resource.data.estado == 'Disponible' && request.resource.data.estado == 'En proceso' && validApprovalDog(request.resource.data,id);
      allow update: if validDogRemoval(request.resource.data,id);
      allow delete: if false;
    }
    function validDogRemoval(d,id) {
      let old = resource.data;
      let control = get(/databases/$(database)/documents/perritos_control/$(id)).data;
      return manages(old.refugioId) && old.get('eliminado',false) == false &&
        old.estado in ['Disponible','Adoptado'] && control.refugioId == old.refugioId &&
        ((old.estado == 'Disponible' && control.solicitudAprobadaId == null && control.adopcionId == null) ||
          (old.estado == 'Adoptado' && control.adopcionId == id)) &&
        d.diff(old).affectedKeys().hasOnly(['eliminado','eliminadoEn','eliminadoPorUid','publicado','actualizadoEn']) &&
        d.eliminado == true && d.eliminadoEn == request.time && d.eliminadoPorUid == request.auth.uid &&
        d.actualizadoEn == request.time && d.publicado == (old.estado == 'Adoptado' ? old.publicado : false);
    }
    function validContact(c) {
      return c is map && c.keys().hasOnly(['nombre','correo','telefono']) &&
        c.nombre is string && c.nombre.size() >= 2 && c.nombre.size() <= 100 && c.nombre.matches('\\S([\\s\\S]*\\S)?') &&
        c.correo is string && c.correo.size() <= 254 && c.correo.matches('[^\\s@]+@[^\\s@]+\\.[^\\s@]+') &&
        c.telefono is string && c.telefono.matches('[0-9]{10}');
    }
    function validHome(h) {
      return h is map && h.keys().hasOnly(['tipoVivienda','tenencia','espacioExterior','personas','horasSolo']) &&
        h.tipoVivienda in ['CASA','DEPARTAMENTO','OTRO'] && h.tenencia in ['PROPIA','RENTADA','FAMILIAR'] &&
        h.espacioExterior is bool && h.personas is int && h.personas >= 1 && h.personas <= 20 &&
        h.horasSolo in ['MENOS_DE_4','DE_4_A_8','MAS_DE_8'];
    }
    function validPets(p) {
      return p is map && p.keys().hasOnly(['tiene','detalle']) && p.tiene is bool &&
        ((!p.tiene && p.detalle == null) || (p.tiene && (p.detalle == null ||
          (p.detalle is string && p.detalle.size() >= 1 && p.detalle.size() <= 500 && p.detalle.matches('\\S([\\s\\S]*\\S)?')))));
    }
    function acceptsRequests(d) {
      let dog = get(/databases/$(database)/documents/perritos/$(d.perritoId)).data;
      let shelter = get(/databases/$(database)/documents/refugios/$(d.refugioId)).data;
      let control = get(/databases/$(database)/documents/perritos_control/$(d.perritoId)).data;
      return dog.publicado == true && dog.estado == 'Disponible' && dog.refugioId == d.refugioId &&
        shelter.activo == true && shelter.municipio == 'Chalco' && shelter.entidad == 'Estado de México' &&
        shelter.requisitos is list && shelter.requisitos.size() > 0 && shelter.pasos is list && shelter.pasos.size() > 0 &&
        control.refugioId == d.refugioId && control.solicitudAprobadaId == null && control.adopcionId == null;
    }
    function validNewApplication(d,id) {
      let key = applicationKey(request.auth.uid,d.perritoId);
      let unique = getAfter(/databases/$(database)/documents/solicitudes_claves/$(key)).data;
      let history = getAfter(/databases/$(database)/documents/historial_solicitudes/$(id + '-1')).data;
      return adopterEnabled() && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}') &&
        d.keys().hasAll(['folio','usuarioUid','perritoId','refugioId','estado','contacto','hogar','otrasMascotas','motivos','motivoNoAprobacion','creadoEn','actualizadoEn']) &&
        d.keys().hasOnly(['folio','usuarioUid','perritoId','refugioId','estado','contacto','hogar','otrasMascotas','motivos','motivoNoAprobacion','creadoEn','actualizadoEn']) &&
        d.usuarioUid == request.auth.uid && d.folio == 'HC-' + id && d.estado == 'Enviada' &&
        d.perritoId is string && d.refugioId is string && d.motivoNoAprobacion == null &&
        validContact(d.contacto) && validHome(d.hogar) && validPets(d.otrasMascotas) &&
        d.motivos is string && d.motivos.size() >= 30 && d.motivos.size() <= 2000 && d.motivos.matches('\\S([\\s\\S]*\\S)?') &&
        d.creadoEn == request.time && d.actualizadoEn == request.time && acceptsRequests(d) &&
        !exists(/databases/$(database)/documents/solicitudes_claves/$(key)) &&
        unique.usuarioUid == request.auth.uid && unique.perritoId == d.perritoId && unique.solicitudId == id &&
        history.solicitudId == id && history.usuarioUid == request.auth.uid && history.refugioId == d.refugioId && history.creadoEn == request.time;
    }
    function validInitialHistory(d,id) {
      let application = getAfter(/databases/$(database)/documents/solicitudes/$(d.solicitudId)).data;
      return adopterEnabled() && id == d.solicitudId + '-1' &&
        d.keys().hasAll(['solicitudId','usuarioUid','refugioId','estadoAnterior','estadoNuevo','motivo','actorUid','creadoEn']) &&
        d.keys().hasOnly(['solicitudId','usuarioUid','refugioId','estadoAnterior','estadoNuevo','motivo','actorUid','creadoEn']) &&
        d.usuarioUid == request.auth.uid && d.actorUid == request.auth.uid && d.estadoAnterior == null && d.estadoNuevo == 'Enviada' &&
        d.motivo == null && d.creadoEn == request.time && application.creadoEn == request.time &&
        application.usuarioUid == request.auth.uid && application.refugioId == d.refugioId && application.estado == 'Enviada';
    }
    function decisionSuffix(state) { return state == 'En revisión' ? 'revision' : state == 'Aprobada' ? 'aprobada' : 'no-aprobada'; }
    function decisionTransition(before,after) {
      return (before == 'Enviada' && after == 'En revisión') ||
        (before == 'En revisión' && after in ['Aprobada','No aprobada']);
    }
    function decisionReason(d) {
      return d.estado == 'No aprobada' ? (d.motivoNoAprobacion is string && d.motivoNoAprobacion.size() >= 5 &&
        d.motivoNoAprobacion.size() <= 1000 && d.motivoNoAprobacion.matches('\\S([\\s\\S]*\\S)?')) : d.motivoNoAprobacion == null;
    }
    function validDecision(d,id) {
      let old = resource.data;
      let history = getAfter(/databases/$(database)/documents/historial_solicitudes/$(id + '-' + decisionSuffix(d.estado))).data;
      let control = get(/databases/$(database)/documents/perritos_control/$(old.perritoId)).data;
      let nextControl = getAfter(/databases/$(database)/documents/perritos_control/$(old.perritoId)).data;
      return manages(old.refugioId) && d.diff(old).affectedKeys().hasOnly(['estado','motivoNoAprobacion','actualizadoEn']) &&
        decisionTransition(old.estado,d.estado) && decisionReason(d) && d.actualizadoEn == request.time && control.adopcionId == null &&
        history.solicitudId == id && history.usuarioUid == old.usuarioUid && history.refugioId == old.refugioId &&
        history.estadoAnterior == old.estado && history.estadoNuevo == d.estado && history.motivo == d.motivoNoAprobacion &&
        history.actorUid == request.auth.uid && history.creadoEn == request.time &&
        (d.estado != 'Aprobada' || (control.solicitudAprobadaId == null && nextControl.solicitudAprobadaId == id &&
          get(/databases/$(database)/documents/perritos/$(old.perritoId)).data.estado == 'Disponible' &&
          get(/databases/$(database)/documents/perritos/$(old.perritoId)).data.publicado == true &&
          getAfter(/databases/$(database)/documents/perritos/$(old.perritoId)).data.actualizadoEn == request.time &&
          getAfter(/databases/$(database)/documents/perritos/$(old.perritoId)).data.estado == 'En proceso'));
    }
    function validDecisionHistory(d,id) {
      let old = get(/databases/$(database)/documents/solicitudes/$(d.solicitudId)).data;
      let after = getAfter(/databases/$(database)/documents/solicitudes/$(d.solicitudId)).data;
      return manages(old.refugioId) &&
        d.keys().hasAll(['solicitudId','usuarioUid','refugioId','estadoAnterior','estadoNuevo','motivo','actorUid','creadoEn']) &&
        d.keys().hasOnly(['solicitudId','usuarioUid','refugioId','estadoAnterior','estadoNuevo','motivo','actorUid','creadoEn']) &&
        id == d.solicitudId + '-' + decisionSuffix(d.estadoNuevo) && decisionTransition(old.estado,after.estado) &&
        d.usuarioUid == old.usuarioUid && d.refugioId == old.refugioId && d.estadoAnterior == old.estado && d.estadoNuevo == after.estado &&
        d.motivo == after.motivoNoAprobacion && d.actorUid == request.auth.uid && d.creadoEn == request.time && after.actualizadoEn == request.time;
    }
    function validApprovalControl(d,id) {
      let old = resource.data;
      let application = get(/databases/$(database)/documents/solicitudes/$(d.solicitudAprobadaId)).data;
      let next = getAfter(/databases/$(database)/documents/solicitudes/$(d.solicitudAprobadaId)).data;
      return manages(old.refugioId) && old.solicitudAprobadaId == null && old.adopcionId == null &&
        d.diff(old).affectedKeys().hasOnly(['solicitudAprobadaId']) && d.solicitudAprobadaId is string &&
        application.refugioId == old.refugioId && application.perritoId == id && application.estado == 'En revisión' &&
        next.estado == 'Aprobada' && next.actualizadoEn == request.time &&
        getAfter(/databases/$(database)/documents/perritos/$(id)).data.estado == 'En proceso';
    }
    function validApprovalDog(d,id) {
      let control = getAfter(/databases/$(database)/documents/perritos_control/$(id)).data;
      let application = getAfter(/databases/$(database)/documents/solicitudes/$(control.solicitudAprobadaId)).data;
      return manages(resource.data.refugioId) && resource.data.estado == 'Disponible' && resource.data.publicado == true &&
        d.estado == 'En proceso' && d.actualizadoEn == request.time && d.diff(resource.data).affectedKeys().hasOnly(['estado','actualizadoEn']) &&
        control.refugioId == resource.data.refugioId && control.adopcionId == null &&
        application.perritoId == id && application.refugioId == resource.data.refugioId && application.estado == 'Aprobada' && application.actualizadoEn == request.time;
    }
    match /solicitudes/{id} {
      allow read: if ownsRecord() || manages(resource.data.refugioId);
      allow get: if resource == null && adopterEnabled();
      allow create: if validNewApplication(request.resource.data,id);
      allow update: if validDecision(request.resource.data,id);
      allow delete: if false;
    }
    match /historial_solicitudes/{id} {
      allow read: if ownsRecord() || manages(resource.data.refugioId);
      allow create: if validInitialHistory(request.resource.data,id) || validDecisionHistory(request.resource.data,id);
      allow update,delete: if false;
    }
    match /adopciones/{id} { allow read: if ownsRecord() || manages(resource.data.refugioId); }
    match /revisiones/{id} { allow read: if manages(resource.data.refugioId); }
    match /seguimientos/{id} { allow read: if manages(resource.data.refugioId); }
    match /perritos_control/{id} {
      allow read: if manages(resource.data.refugioId);
      allow create: if manages(request.resource.data.refugioId) &&
        request.resource.data.keys().hasAll(['refugioId','solicitudAprobadaId','adopcionId']) &&
        request.resource.data.keys().hasOnly(['refugioId','solicitudAprobadaId','adopcionId']) &&
        request.resource.data.solicitudAprobadaId == null && request.resource.data.adopcionId == null &&
        !exists(/databases/$(database)/documents/perritos/$(id)) &&
        getAfter(/databases/$(database)/documents/perritos/$(id)).data.refugioId == request.resource.data.refugioId;
      allow update: if request.resource.data.adopcionId == resource.data.adopcionId && validApprovalControl(request.resource.data,id);
      allow delete: if false;
    }
    match /solicitudes_claves/{id} {
      allow read: if ownsRecord();
      allow get: if resource == null && adopterEnabled();
      allow create: if adopterEnabled() && request.resource.data.keys().hasAll(['usuarioUid','perritoId','solicitudId']) &&
        request.resource.data.keys().hasOnly(['usuarioUid','perritoId','solicitudId']) &&
        request.resource.data.usuarioUid == request.auth.uid && id == applicationKey(request.auth.uid,request.resource.data.perritoId) &&
        getAfter(/databases/$(database)/documents/solicitudes/$(request.resource.data.solicitudId)).data.usuarioUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/solicitudes/$(request.resource.data.solicitudId)).data.perritoId == request.resource.data.perritoId &&
        getAfter(/databases/$(database)/documents/solicitudes/$(request.resource.data.solicitudId)).data.creadoEn == request.time;
      allow update,delete: if false;
    }
    // Spark: las transacciones del cliente se verifican íntegramente aquí.
    function validDelivery(d,id) {
      let application = get(/databases/$(database)/documents/solicitudes/$(d.solicitudId)).data;
      let dog = get(/databases/$(database)/documents/perritos/$(id)).data;
      let control = get(/databases/$(database)/documents/perritos_control/$(id)).data;
      return manages(d.refugioId) &&
        d.keys().hasAll(['solicitudId','perritoId','usuarioUid','refugioId','fechaEntrega','cartaFirmada','registradoPorUid','creadoEn']) &&
        d.keys().hasOnly(['solicitudId','perritoId','usuarioUid','refugioId','fechaEntrega','cartaFirmada','registradoPorUid','creadoEn']) &&
        d.perritoId == id && d.usuarioUid == application.usuarioUid && d.refugioId == application.refugioId &&
        application.perritoId == id && application.estado == 'Aprobada' && dog.refugioId == d.refugioId &&
        dog.publicado == true && dog.estado == 'En proceso' && control.refugioId == d.refugioId &&
        control.solicitudAprobadaId == d.solicitudId && control.adopcionId == null &&
        d.fechaEntrega is timestamp && d.fechaEntrega > timestamp.date(1970,1,1) && d.fechaEntrega <= request.time &&
        d.cartaFirmada == true && d.registradoPorUid == request.auth.uid && d.creadoEn == request.time &&
        getAfter(/databases/$(database)/documents/perritos/$(id)).data.estado == 'Adoptado' &&
        getAfter(/databases/$(database)/documents/perritos/$(id)).data.actualizadoEn == request.time &&
        getAfter(/databases/$(database)/documents/perritos_control/$(id)).data.adopcionId == id;
    }
    function deliveryDog(d,id) {
      let adoption = getAfter(/databases/$(database)/documents/adopciones/$(id)).data;
      return manages(resource.data.refugioId) && resource.data.estado == 'En proceso' &&
        d.diff(resource.data).affectedKeys().hasOnly(['estado','actualizadoEn']) && d.estado == 'Adoptado' &&
        d.actualizadoEn == request.time && !exists(/databases/$(database)/documents/adopciones/$(id)) &&
        adoption.perritoId == id && adoption.refugioId == resource.data.refugioId && adoption.creadoEn == request.time;
    }
    function deliveryControl(d,id) {
      let adoption = getAfter(/databases/$(database)/documents/adopciones/$(id)).data;
      return manages(resource.data.refugioId) && resource.data.adopcionId == null &&
        d.diff(resource.data).affectedKeys().hasOnly(['adopcionId']) && d.adopcionId == id &&
        !exists(/databases/$(database)/documents/adopciones/$(id)) && adoption.creadoEn == request.time &&
        adoption.refugioId == resource.data.refugioId && adoption.solicitudId == resource.data.solicitudAprobadaId;
    }
    function closedElsewhere(d,id) {
      let old = resource.data;
      let adoption = get(/databases/$(database)/documents/adopciones/$(old.perritoId)).data;
      let history = getAfter(/databases/$(database)/documents/historial_solicitudes/$(id + '-no-aprobada')).data;
      return manages(old.refugioId) && old.estado in ['Enviada','En revisión'] && d.estado == 'No aprobada' &&
        d.diff(old).affectedKeys().hasOnly(['estado','motivoNoAprobacion','actualizadoEn']) &&
        d.motivoNoAprobacion == 'El perrito fue adoptado por otra persona.' && d.actualizadoEn == request.time &&
        adoption.refugioId == old.refugioId && adoption.perritoId == old.perritoId && adoption.solicitudId != id &&
        history.solicitudId == id && history.usuarioUid == old.usuarioUid && history.refugioId == old.refugioId &&
        history.estadoAnterior == old.estado && history.estadoNuevo == d.estado && history.motivo == d.motivoNoAprobacion &&
        history.actorUid == request.auth.uid && history.creadoEn == request.time;
    }
    function closedHistory(d,id) {
      let old = get(/databases/$(database)/documents/solicitudes/$(d.solicitudId)).data;
      let after = getAfter(/databases/$(database)/documents/solicitudes/$(d.solicitudId)).data;
      let adoption = get(/databases/$(database)/documents/adopciones/$(old.perritoId)).data;
      return manages(old.refugioId) &&
        d.keys().hasAll(['solicitudId','usuarioUid','refugioId','estadoAnterior','estadoNuevo','motivo','actorUid','creadoEn']) &&
        d.keys().hasOnly(['solicitudId','usuarioUid','refugioId','estadoAnterior','estadoNuevo','motivo','actorUid','creadoEn']) &&
        id == d.solicitudId + '-no-aprobada' && old.estado in ['Enviada','En revisión'] &&
        d.usuarioUid == old.usuarioUid && d.refugioId == old.refugioId && d.estadoAnterior == old.estado &&
        d.estadoNuevo == 'No aprobada' && d.motivo == 'El perrito fue adoptado por otra persona.' &&
        d.actorUid == request.auth.uid && d.creadoEn == request.time && after.actualizadoEn == request.time &&
        after.estado == d.estadoNuevo && after.motivoNoAprobacion == d.motivo &&
        adoption.refugioId == old.refugioId && adoption.solicitudId != d.solicitudId;
    }
    function nextKey(id) { return hashing.sha256(id + '\u0000next').toHexString().lower(); }
    function validReview(d,id) {
      let adoption = get(/databases/$(database)/documents/adopciones/$(d.adopcionId)).data;
      return manages(d.refugioId) &&
        d.keys().hasAll(['adopcionId','perritoId','refugioId','fechaProgramada','tipo','estado','seguimientoId','creadoEn']) &&
        d.keys().hasOnly(['adopcionId','perritoId','refugioId','fechaProgramada','tipo','estado','seguimientoId','creadoEn','revisionOrigenId']) &&
        d.adopcionId == d.perritoId && adoption.perritoId == d.perritoId && adoption.refugioId == d.refugioId &&
        d.fechaProgramada is timestamp && d.fechaProgramada >= adoption.fechaEntrega &&
        d.tipo in ['VISITA','LLAMADA','VIDEOLLAMADA'] && d.estado == 'PROGRAMADA' && d.seguimientoId == null && d.creadoEn == request.time &&
        ((!('revisionOrigenId' in d) && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')) ||
         ('revisionOrigenId' in d && id == nextKey(d.revisionOrigenId) &&
          getAfter(/databases/$(database)/documents/seguimientos/$(d.revisionOrigenId)).data.siguienteRevisionId == id &&
          getAfter(/databases/$(database)/documents/seguimientos/$(d.revisionOrigenId)).data.adopcionId == d.adopcionId &&
          getAfter(/databases/$(database)/documents/seguimientos/$(d.revisionOrigenId)).data.creadoEn == request.time &&
          d.fechaProgramada > getAfter(/databases/$(database)/documents/seguimientos/$(d.revisionOrigenId)).data.fechaRealizacion));
    }
    function completeReview(d,id) {
      let result = getAfter(/databases/$(database)/documents/seguimientos/$(id)).data;
      return manages(resource.data.refugioId) && resource.data.estado == 'PROGRAMADA' && resource.data.seguimientoId == null &&
        d.diff(resource.data).affectedKeys().hasOnly(['estado','seguimientoId']) && d.estado == 'REALIZADA' && d.seguimientoId == id &&
        !exists(/databases/$(database)/documents/seguimientos/$(id)) && result.creadoEn == request.time &&
        result.revisionId == id && result.adopcionId == resource.data.adopcionId && result.refugioId == resource.data.refugioId;
    }
    function validFollowup(d,id) {
      let review = get(/databases/$(database)/documents/revisiones/$(id)).data;
      let adoption = get(/databases/$(database)/documents/adopciones/$(d.adopcionId)).data;
      return manages(d.refugioId) &&
        d.keys().hasAll(['adopcionId','revisionId','perritoId','refugioId','fechaRealizacion','adaptacion','observaciones','fotos','registradoPorUid','siguienteRevisionId','creadoEn']) &&
        d.keys().hasOnly(['adopcionId','revisionId','perritoId','refugioId','fechaRealizacion','adaptacion','observaciones','fotos','registradoPorUid','siguienteRevisionId','creadoEn']) &&
        d.revisionId == id && review.estado == 'PROGRAMADA' && review.seguimientoId == null &&
        d.adopcionId == review.adopcionId && d.perritoId == review.perritoId && d.refugioId == review.refugioId &&
        adoption.refugioId == d.refugioId && adoption.perritoId == d.perritoId &&
        d.fechaRealizacion is timestamp && d.fechaRealizacion >= adoption.fechaEntrega && d.fechaRealizacion <= request.time &&
        d.adaptacion in ['MUY_BUENA','BUENA','REGULAR','CON_DIFICULTADES'] &&
        d.observaciones is string && d.observaciones.size() >= 15 && d.observaciones.size() <= 2000 && d.observaciones.matches('\\S([\\s\\S]*\\S)?') &&
        d.registradoPorUid == request.auth.uid && d.creadoEn == request.time &&
        getAfter(/databases/$(database)/documents/revisiones/$(id)).data.estado == 'REALIZADA' &&
        getAfter(/databases/$(database)/documents/revisiones/$(id)).data.seguimientoId == id &&
        d.fotos is list && (d.fotos.size() == 0 || (d.fotos.size() == 1 &&
          d.fotos[0].keys().hasOnly(['archivoId','ruta','orden']) && d.fotos[0].orden == 0 &&
          d.fotos[0].ruta == 'refugios/' + d.refugioId + '/seguimientos/' + id + '/' + d.fotos[0].archivoId + '.jpg' &&
          get(/databases/$(database)/documents/imagenes/$(hashing.sha256(d.fotos[0].ruta).toHexString().lower())).data.ruta == d.fotos[0].ruta)) &&
        (d.siguienteRevisionId == null || (d.siguienteRevisionId == nextKey(id) &&
          !exists(/databases/$(database)/documents/revisiones/$(d.siguienteRevisionId)) &&
          getAfter(/databases/$(database)/documents/revisiones/$(d.siguienteRevisionId)).data.revisionOrigenId == id &&
          getAfter(/databases/$(database)/documents/revisiones/$(d.siguienteRevisionId)).data.creadoEn == request.time));
    }
    match /adopciones/{id} {
      allow get: if resource == null && manages(get(/databases/$(database)/documents/perritos/$(id)).data.refugioId);
      allow create: if validDelivery(request.resource.data,id);
    }
    match /perritos/{id} { allow update: if resource.data.estado == 'En proceso' && request.resource.data.estado == 'Adoptado' && deliveryDog(request.resource.data,id); }
    match /perritos_control/{id} { allow update: if deliveryControl(request.resource.data,id); }
    match /solicitudes/{id} { allow update: if closedElsewhere(request.resource.data,id); }
    match /historial_solicitudes/{id} { allow create: if closedHistory(request.resource.data,id); }
    match /revisiones/{id} {
      allow get: if resource == null && activeUser();
      allow create: if validReview(request.resource.data,id);
      allow update: if completeReview(request.resource.data,id);
    }
    match /seguimientos/{id} {
      allow get: if resource == null && manages(get(/databases/$(database)/documents/revisiones/$(id)).data.refugioId);
      allow create: if validFollowup(request.resource.data,id);
    }
    function imageValid(d,id) {
      return d.keys().hasAll(['ruta','refugioId','perritoId','revisionId','datos']) &&
        d.keys().hasOnly(['ruta','refugioId','perritoId','revisionId','datos']) && manages(d.refugioId) &&
        id == hashing.sha256(d.ruta).toHexString().lower() && d.datos is string &&
        d.datos.size() >= 8 && d.datos.size() <= 136536 && d.datos.matches('/9j/[A-Za-z0-9+/]*={0,2}') &&
        ((d.revisionId == null && d.perritoId is string &&
          d.ruta.matches('perritos/' + d.refugioId + '/' + request.auth.uid + '/' + d.perritoId + '/[A-Za-z0-9-]{1,100}\\.jpg') &&
          (!exists(/databases/$(database)/documents/perritos/$(d.perritoId)) || get(/databases/$(database)/documents/perritos/$(d.perritoId)).data.refugioId == d.refugioId)) ||
         (d.perritoId == null && d.revisionId is string &&
          d.ruta.matches('refugios/' + d.refugioId + '/seguimientos/' + d.revisionId + '/[A-Za-z0-9-]{1,100}\\.jpg') &&
          get(/databases/$(database)/documents/revisiones/$(d.revisionId)).data.refugioId == d.refugioId &&
          get(/databases/$(database)/documents/revisiones/$(d.revisionId)).data.estado == 'PROGRAMADA'));
    }
    match /imagenes/{id} {
      allow get: if (resource == null && activeUser()) || manages(resource.data.refugioId) ||
        (resource.data.revisionId == null &&
          get(/databases/$(database)/documents/perritos/$(resource.data.perritoId)).data.fotos[0].ruta == resource.data.ruta &&
          ((get(/databases/$(database)/documents/perritos/$(resource.data.perritoId)).data.publicado == true &&
            get(/databases/$(database)/documents/perritos/$(resource.data.perritoId)).data.estado in ['Disponible','En proceso']) ||
           (adopterEnabled() && get(/databases/$(database)/documents/adopciones/$(resource.data.perritoId)).data.usuarioUid == request.auth.uid)));
      allow create: if imageValid(request.resource.data,id);
      allow update,delete,list: if false;
    }
    // Las escrituras de negocio se habilitan al implementar y validar su historia.
    match /{document=**} { allow read, write: if false; }
  }
}
